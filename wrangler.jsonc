{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anywhere-hub",
  "compatibility_date": "2026-06-11",
  "main": "./src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "IMPORT_STATS", "class_name": "ImportStats" }]
  },
  "migrations": [{ "tag": "import-stats-v1", "new_sqlite_classes": ["ImportStats"] }],
  "observability": {
    "enabled": false
  }
}
